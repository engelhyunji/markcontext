<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE taglib PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.1//EN" "http://java.sun.com/j2ee/dtds/web-jsptaglibrary_1_1.dtd">
<taglib>
	<tlibversion>1.0</tlibversion>
	<jspversion>1.1</jspversion>
	<shortname>MarkAny Original Html Tag</shortname>
	<uri>http://www.markany.com/epagesafer</uri>
	<info>MarkAny Original Html Tag Library</info>
	
	<tag>
		<name>MarkAnyData</name>
		<tagclass>com.markany.fps.MaFpsGetOrgDataTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<info>Original Temp FileName</info>
		<attribute>
			<name>filename</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>characterset</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	
	<tag>
		<name>MarkAnyHtmlData</name>
		<tagclass>com.markany.fps.MaFpsGetOrgDataTagEx</tagclass>
		<bodycontent>JSP</bodycontent>
		<info>Original Memory HtmlData</info>
		<attribute>
			<name>beanName</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
</taglib>